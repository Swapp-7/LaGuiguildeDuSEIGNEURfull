
{% extends 'base.html.twig' %}

{% block title %}Personnages avec vie > 100{% endblock %}

{% block body %}
    <h1 class="text-center">Personnages avec vie supérieure à 100</h1>

    <table class="table table-hover">
        <thead>
            <tr>
                <th class="text-center">Kind</th>
                <th class="text-center">Name</th>
                <th class="text-center">Slug</th>
                <th class="text-center">Surname</th>
                <th class="text-center">Caste</th>
                <th class="text-center">Knowledge</th>
                <th class="text-center">Intelligence</th>
                <th class="text-center">Strength</th>
                <th class="text-center">Vie</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for character in characters %}
            <tr>
                <td class="text-center">
                    {% if character.kind == 'Dame' %}
                        <strong>{{ character.kind }}</strong>
                    {% else %}
                        {{ character.kind }}
                    {% endif %}
                </td>
                <td class="text-center">
                    <a href="{{ path('api_character_show', {'identifier': character.identifier}) }}">{{ character.name }}</a>
                </td>
                <td class="text-center">{{ character.slug }}</td>
                <td class="text-center">{{ character.surname }}</td>
                <td class="text-center">{{ character.caste }}</td>
                <td class="text-center">{{ character.knowledge }}</td>
                <td class="text-center">{{ character.intelligence }}</td>
                <td class="text-center">{{ character.strength }}</td>
                <td class="text-center">{{ character.life }}</td>
                <td class="text-center">
                    <a href="{{ path('api_character_edit', {'identifier': character.identifier}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10" class="text-center">Aucun personnage avec vie supérieure à 100</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="text-center">
        <a href="{{ path('app_character_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>
{% endblock %}
